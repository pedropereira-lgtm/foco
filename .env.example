# Copia este ficheiro para .env.local e preenche.
# Nenhuma destas chaves vai para o browser: só o servidor as lê.

# ── Acesso ────────────────────────────────────────────────
# A password com que entras no Foco.
APP_PASSWORD=
# Texto aleatório longo (assina o cookie de sessão). Podes deixar o que gerei.
AUTH_SECRET=

# ── Supabase (Project Settings → API) ─────────────────────
SUPABASE_URL=https://cxmdteicccfeeowizvcd.supabase.co
# "service_role" (secreta). Sem ela, localmente os dados ficam em .data/foco.json
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Developers → API keys → Restricted key, só leitura) ──
STRIPE_SECRET_KEY=
# Aparece depois de criares o webhook (Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=

# ── Telegram (@BotFather → /newbot) ───────────────────────
TELEGRAM_BOT_TOKEN=
# Texto aleatório; protege o endereço que o Telegram chama
TELEGRAM_WEBHOOK_SECRET=

# ── Tarefas automáticas (cron) ────────────────────────────
CRON_SECRET=
# Endereço público da app (ex: https://foco.starmountainflash.pt)
APP_URL=http://localhost:3000
